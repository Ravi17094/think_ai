generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====================================================
// ENUMS
// ====================================================

enum AssessmentType {
  MCQ
  CODING
}

// ====================================================
// COURSE
// ====================================================

model Course {
  id                Int     @id @default(autoincrement())
  title             String
  description       String
  category          String
  price             Float
  duration          String
  thumbnail         String?
  videoUrl          String?
  instructorName    String?
  instructorDetails String?
  status            String  @default("ACTIVE")

  batches Batch[]
  modules Module[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
}

// ====================================================
// BATCH
// ====================================================

model Batch {
  id   Int    @id @default(autoincrement())
  name String

  courseId Int
  course   Course @relation(fields: [courseId], references: [id])

  instructorName String
  capacity       Int
  startDate      DateTime
  endDate        DateTime
  status         String   @default("ACTIVE")

  enrollments Enrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([status])
  @@index([startDate])
}

// ====================================================
// ENROLLMENT
// ====================================================

model Enrollment {
  id           Int    @id @default(autoincrement())
  studentName  String
  studentEmail String
  batchId      Int

  batch Batch @relation(fields: [batchId], references: [id])

  enrollmentStatus String  @default("ENROLLED")
  courseAccess     Boolean @default(false)

  enrolledAt DateTime @default(now())

  lessonProgress        LessonProgress[]
  assessmentSubmissions AssessmentSubmission[]
  attendanceRecords     AttendanceRecord[]
  certificate           Certificate?

  @@index([batchId])
  @@index([studentEmail])
  @@index([enrollmentStatus])
  @@index([courseAccess])
}

// ====================================================
// ATTENDANCE
// ====================================================

model AttendanceRecord {
  id Int @id @default(autoincrement())

  enrollmentId Int
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  sessionTitle String
  sessionDate  DateTime
  status       String   @default("PRESENT")
  notes        String?
  recordedBy   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrollmentId, sessionDate, sessionTitle])
  @@index([sessionDate])
  @@index([status])
}

// ====================================================
// USER
// ====================================================

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String   @default("") // Added default
  name      String?
  role      String   @default("Learner")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
}

// ====================================================
// MODULE
// ====================================================

model Module {
  id          Int     @id @default(autoincrement())
  title       String
  description String?

  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons     Lesson[]
  assessments Assessment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
}

// ====================================================
// LESSON
// ====================================================

model Lesson {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  content     String?
  videoUrl    String?
  duration    String?
  order       Int     @default(0)

  moduleId Int
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  progress LessonProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
  @@index([moduleId, order])
}

// ====================================================
// LESSON PROGRESS
// ====================================================

model LessonProgress {
  id               Int       @id @default(autoincrement())
  enrollmentId     Int
  lessonId         Int
  watchedSeconds   Float     @default(0.0)
  totalDuration    Float     @default(0.0)
  watchPercentage  Float     @default(0.0)
  completed        Boolean   @default(false)
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  enrollment       Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson           Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
}

// ====================================================
// CERTIFICATE
// ====================================================

model Certificate {
  id            Int    @id @default(autoincrement())
  certificateNo String @unique

  enrollmentId Int        @unique
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  studentName          String
  courseName           String
  instructorName       String?
  completionPercentage Float

  issuedAt DateTime @default(now())

  pdfUrl          String?
  verificationUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ====================================================
// ASSESSMENT
// ====================================================

model Assessment {
  id          Int            @id @default(autoincrement())
  title       String
  description String?
  type        AssessmentType @default(MCQ)
  totalMarks  Int
  duration    Int?
  status      String         @default("ACTIVE")

  moduleId Int
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  questions   Question[]
  submissions AssessmentSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
  @@index([status])
  @@index([type])
}

// ====================================================
// QUESTION
// ====================================================

model Question {
  id Int @id @default(autoincrement())

  // ==================================================
  // BASIC INFORMATION
  // ==================================================

  title        String?
  questionText String

  // MCQ / CODING / DESCRIPTIVE
  questionType String @default("MCQ")

  // EASY / MEDIUM / HARD
  difficulty String?

  marks Int @default(1)
  order Int @default(0)

  // ==================================================
  // CODING PROBLEM INFORMATION
  // ==================================================

  problemStatement String?
  inputFormat      String?
  outputFormat     String?
  constraints      String?
  explanation      String?

  // Example:
  //
  // [
  //   {
  //     "input": "5\n10 20 5 40 30",
  //     "output": "40",
  //     "explanation": "40 is the maximum."
  //   }
  // ]

  examples Json?

  // ==================================================
  // SUPPORTED LANGUAGES
  // ==================================================

  // Example:
  //
  // [
  //   "python",
  //   "javascript",
  //   "java",
  //   "cpp"
  // ]

  supportedLanguages Json?

  // ==================================================
  // STARTER CODE
  // ==================================================

  // Example:
  //
  // {
  //   "python": "# Write your solution here",
  //   "javascript": "// Write your solution here",
  //   "java": "public class Main {}",
  //   "cpp": "#include <iostream>"
  // }

  starterCode Json?

  // ==================================================
  // ASSESSMENT RELATION
  // ==================================================

  assessmentId Int
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  // ==================================================
  // QUESTION RELATIONS
  // ==================================================

  options           Option[]
  submissionAnswers SubmissionAnswer[]

  codingTestCases CodingTestCase[]

  codingTestCaseExecutions CodingTestCaseExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assessmentId])
  @@index([assessmentId, order])
  @@index([questionType])
  @@index([difficulty])
}

// ====================================================
// OPTION
// ====================================================

model Option {
  id         Int     @id @default(autoincrement())
  optionText String
  isCorrect  Boolean @default(false)

  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([questionId])
}

// ====================================================
// CODING TEST CASE
// ====================================================

model CodingTestCase {
  id Int @id @default(autoincrement())

  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  // Input given to student's program.
  input String?

  // Expected program output.
  expectedOutput String

  // Marks for this test case.
  marks Float @default(1)

  // false = public
  // true  = hidden
  isHidden Boolean @default(false)

  executions CodingTestCaseExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([questionId])
}

// ====================================================
// ASSESSMENT SUBMISSION
// ====================================================

model AssessmentSubmission {
  id Int @id @default(autoincrement())

  assessmentId Int
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  enrollmentId Int
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  // ==================================================
  // JUDGE0
  // ==================================================

  judge0Token  String? @unique
  judge0Status String?

  stdout        String?
  stderr        String?
  compileOutput String?

  executionTime String?
  memory        Int?

  // ==================================================
  // ASSESSMENT RESULT
  // ==================================================

  score      Float?
  totalMarks Int
  percentage Float?

  status String @default("SUBMITTED")

  feedback String?
  gradedBy String?
  gradedAt DateTime?

  submittedAt DateTime @default(now())

  answers SubmissionAnswer[]

  codingTestCaseExecutions CodingTestCaseExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assessmentId])
  @@index([enrollmentId])
  @@index([status])
}

// ====================================================
// SUBMISSION ANSWER
// ====================================================

model SubmissionAnswer {
  id Int @id @default(autoincrement())

  submissionId Int
  submission   AssessmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  // MCQ
  selectedOptionId Int?

  // Coding / descriptive
  answerText String?
  code       String?

  // Evaluation
  isCorrect     Boolean?
  marksObtained Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([submissionId, questionId])
  @@index([questionId])
}

// ====================================================
// LIVE SESSION (Live Class Studio)
//
// Identity for live participants is stored as a flexible
// string userId + denormalized userName (mirrors the
// existing Forum module demo identities "u1".."u8") so the
// existing Live Class UI keeps working while persisting to
// PostgreSQL. No hard FK to the thin LMS `User` table is
// introduced to avoid coupling the self-contained Forum
// module to a user model that lacks a display name.
// ====================================================

model LiveSession {
  id        String   @id
  title     String
  hostId    String
  status    String   @default("live")
  startedAt DateTime @default(now())

  attendees LiveAttendee[]
  messages  LiveMessage[]
  polls     LivePoll[]
  breakouts BreakoutRoom[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([hostId])
}

model LiveAttendee {
  id        Int    @id @default(autoincrement())
  sessionId String
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  userId   String
  userName String

  online     Boolean @default(true)
  muted      Boolean @default(true)
  cameraOn   Boolean @default(false)
  raisedHand Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}

model LiveMessage {
  id        Int    @id @default(autoincrement())
  sessionId String
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  userId   String
  userName String
  text     String
  deleted  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([sessionId, createdAt])
}

model LivePoll {
  id        Int    @id @default(autoincrement())
  sessionId String
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  question String
  status   String @default("open")

  options LivePollOption[]
  votes   LivePollVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
  @@index([status])
}

model LivePollOption {
  id     Int    @id @default(autoincrement())
  pollId Int
  poll   LivePoll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  text  String
  votes Int @default(0)

  pollVotes LivePollVote[]

  @@index([pollId])
}

model LivePollVote {
  id     Int    @id @default(autoincrement())
  pollId Int
  poll   LivePoll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  optionId Int
  option   LivePollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  userId String

  createdAt DateTime @default(now())

  // One vote per user per poll (switching moves the vote).
  @@unique([pollId, userId])
  @@index([pollId])
  @@index([userId])
}

model BreakoutRoom {
  id        Int    @id @default(autoincrement())
  sessionId String
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  name   String
  status String @default("active")

  members BreakoutRoomMember[]

  @@index([sessionId])
  @@index([status])
}

// CODING TEST CASE EXECUTION
// ====================================================

model CodingTestCaseExecution {
  id Int @id @default(autoincrement())

  // ==================================================
  // RELATIONS
  // ==================================================

  submissionId Int
  submission   AssessmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  testCaseId Int
  testCase   CodingTestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  // ==================================================
  // JUDGE0
  // ==================================================

  judge0Token String @unique

  judge0Status String?

  // ==================================================
  // EXECUTION RESULT
  // ==================================================

  actualOutput   String?
  expectedOutput String?

  executionTime String?
  memory        Int?

  // ==================================================
  // GRADING
  // ==================================================

  passed        Boolean @default(false)
  marksObtained Float   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([submissionId])
  @@index([questionId])
  @@index([testCaseId])
}

model BreakoutRoomMember {
  id        Int    @id @default(autoincrement())
  roomId    Int
  room      BreakoutRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  userId   String
  userName String

  createdAt DateTime @default(now())

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
}
