{
  "name": "backend",
  "version": "1.0.0",
  "description": "Thinkz Ai LMS Backend",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "lint": "node --check server.js && node --check app.js",
    "build": "node --check server.js && node --check app.js",
    "test:audit": "node --test auditLogService.test.js authFlow.test.js communityModeration.test.js discountCheck.test.js",
    "test:ci": "node --test auditLogService.test.js emailIntegration.test.js notificationPreferenceService.test.js paymentEdgeCases.test.js",
    "test:param": "node --test lms/tests/*.test.js",
    "test:param:db": "node --test lms/tests/database.integration.lms/tests/desktop-database.integration.lms/tests/web-database.integration.js",
    "stress:param": "node lms/scripts/stress.js",
    "verify:content": "node lms/scripts/verify-content.js",
    "verify:local": "node lms/scripts/verify-local.js",
    "seed:local": "node lms/scripts/seed-local.js",
    "baseline:day7": "node lms/scripts/baseline-local.js",
    "e2e:day7": "node lms/scripts/day7-e2e.js",
    "sample:certificate": "node lms/scripts/sample-certificate.js",
    "test:routes": "node --test --test-concurrency=1 livestudioRoutes.test.js forumRoutes.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@sendgrid/mail": "^8.1.6",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "debug": "^4.4.3",
    "depd": "^2.0.0",
    "dotenv": "^17.4.2",
    "es-to-primitive": "^1.3.4",
    "express": "^4.19.2",
    "express-rate-limit": "^6.7.1",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "node-cache": "^5.1.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.22.0",
    "prisma": "^5.22.0",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/s3-request-presigner": "^3.922.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "superfast": "^0.1.1",
    "supertest": "^7.2.2"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@scarf/scarf@1.4.0": true,
    "prisma@6.19.3": true
  }
}