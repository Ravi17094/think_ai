        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"New course\",\n  \"description\": \"Course description\",\n  \"category\": \"Programming\",\n  \"price\": 0,\n  \"duration\": \"1 hour\",\n  \"completionThreshold\": 80\n}",
          "options": {
