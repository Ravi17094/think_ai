{
  "info": {
    "name": "Patan LMS APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "id",
      "value": "1"
    },
    {
      "key": "enrollmentId",
      "value": "1"
    },
    {
      "key": "lessonId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Learner profile and last 10 activities",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/lms/me"
      }
    },
    {
      "name": "Update own display name",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/lms/me",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Patan\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Own enrollments and completion summaries",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/lms/enrollments"
      }
    },
    {
      "name": "Active course catalog",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/lms/courses"
      }
    },
    {
      "name": "Owned course hierarchy, lesson content and progress",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/lms/courses/{{id}}/player"
      }
    },
    {
      "name": "Owned lesson content",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/lms/enrollments/{{enrollmentId}}/lessons/{{lessonId}}/content"
      }
    },
    {
      "name": "Get private lesson notes",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/lms/enrollments/{{enrollmentId}}/lessons/{{lessonId}}/notes"
      }
    },
    {
      "name": "Save private lesson notes",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/lms/enrollments/{{enrollmentId}}/lessons/{{lessonId}}/notes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"My lesson notes\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Sync progress; server version wins conflicts",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/lms/progress/sync",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"updates\": [\n    {\n      \"lessonId\": 1,\n      \"enrollmentId\": 1,\n      \"watchedSeconds\": 60,\n      \"updatedAt\": \"2026-10-22T10:00:00Z\",\n      \"baseVersion\": null\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Start or resume timed attempt without answer keys",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/lms/assessments/{{id}}/start",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"enrollmentId\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Idempotent submission and durable auto-grading",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/lms/assessments/{{id}}/submit",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"attemptId\": 1,\n  \"answers\": [\n    {\n      \"questionId\": 1,\n      \"selectedOptionId\": 1\n    }\n  ],\n  \"flaggedQuestionIds\": [\n    1\n  ],\n  \"timestamp\": \"2026-10-22T10:00:00Z\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Owned results; poll until GRADED or FAILED",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/lms/attempts/{{id}}/results"
      }
    },
    {
      "name": "Generate eligible certificate, upload PDF and queue email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/lms/certificates/generate",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"enrollmentId\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Owned certificate with signed download URL",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/lms/certificates/{{id}}"
      }
    },
    {
      "name": "Run sandbox code in Python, JavaScript, Java or C++",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/lms/code/execute",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"language\": \"python\",\n  \"sourceCode\": \"print(42)\",\n  \"timeout\": 30,\n  \"testCases\": [\n    {\n      \"input\": \"\",\n      \"expectedOutput\": \"42\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Admin KPI, enrollment trend and course performance",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/lms/analytics"
      }
    },
