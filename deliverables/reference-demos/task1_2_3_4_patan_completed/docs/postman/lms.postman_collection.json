    {
      "name": "Authentication",
      "item": [
        {
          "name": "Sign in as admin",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{adminPassword}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Sign in succeeds', () => pm.expect(pm.response.code).to.equal(200));",
                  "if (pm.response.code === 200) pm.environment.set('adminToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in as learner",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
