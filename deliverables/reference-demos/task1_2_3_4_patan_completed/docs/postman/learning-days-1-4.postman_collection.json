{
  "info": {
    "name": "Patan — Learning Days 1–4",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "courseId",
      "value": "1"
    },
    {
      "key": "moduleId",
      "value": "1"
    },
    {
      "key": "lessonId",
      "value": "1"
    },
    {
      "key": "enrollmentId",
      "value": "1"
    },
    {
      "key": "assessmentId",
      "value": "1"
    },
    {
      "key": "questionId",
      "value": "1"
    },
    {
      "key": "optionId",
      "value": "1"
    },
    {
      "key": "certificateId",
      "value": "1"
    },
    {
      "key": "batchId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "List courses",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/lms/courses",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    },
    {
      "name": "Create course (staff)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/lms/courses",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"React Native\",\n  \"description\": \"Course\",\n  \"category\": \"Development\",\n  \"price\": 0,\n  \"duration\": \"1h\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Course curriculum",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/lms/courses/{{courseId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    },
    {
      "name": "Update course (staff)",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/lms/courses/{{courseId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated title\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Delete course (staff)",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/lms/courses/{{courseId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    },
    {
      "name": "Create ordered module (staff)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/lms/courses/{{courseId}}/modules",
        "header": [
          {
            "key": "Content-Type",
