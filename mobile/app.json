{
  "expo": {
    "name": "ThinkZai Mobile",
    "slug": "thinkzai-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "thinkzai",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "updates": {
      "enabled": false
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thinkzai.mobile"
    },
    "android": {
      "package": "com.thinkzai.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B1020"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-notifications",
      "./plugins/withPatanDownloads",
      "expo-video",
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ]
  }
}
